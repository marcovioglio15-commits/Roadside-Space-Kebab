    Entries:
    - Name: Shadowblade Order Correct 1
      Weight: 1
      RequiredFlags: []
      RequireAll: 1
      Lines:
      - Speaker: Shadowblade Hellfury
        Text: Ahh, manna from Pandemonium itself.
    - Name: Shadowblade Order Correct 2
      Weight: 1
      RequiredFlags: []
      RequireAll: 1
      Lines:
      - Speaker: Shadowblade Hellfury
        Text: 'Heh, not bad for a mortal.

'
    - Name: Shadowblade Order Correct 3
      Weight: 1
      RequiredFlags: []
      RequireAll: 1
      Lines:
      - Speaker: Shadowblade Hellfury
        Text: Your skills impress me, chef.
    - Name: Shadowblade Order Correct 4
      Weight: 1
      RequiredFlags: []
      RequireAll: 1
      Lines:
      - Speaker: Shadowblade Hellfury
        Text: 'The Elder Gods are pleased.

'
    - Name: Shadowblade Order Correct 5
      Weight: 1
      RequiredFlags: []
      RequireAll: 1
      Lines:
      - Speaker: Shadowblade Hellfury
        Text: 'This will do.

'
    - Name: Shadowblade Order Correct 6
      Weight: 1
      RequiredFlags: []
      RequireAll: 1
      Lines:
      - Speaker: Shadowblade Hellfury
        Text: "My demons\u2026 pleased\u2026\n"
    - Name: Shadowblade Order Correct 7
      Weight: 1
      RequiredFlags: []
      RequireAll: 1
      Lines:
      - Speaker: Shadowblade Hellfury
        Text: "\u2026I\u2019ll be back.\n"
    - Name: Shadowblade Order Correct 7
